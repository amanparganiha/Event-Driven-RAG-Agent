# Copy to .env and fill in. Required for both the deployed app and local runs.
OPENAI_API_KEY=sk-your-openai-key

# Vector store (optional).
# Leave QDRANT_URL unset to use the embedded in-memory store (default; good for
# Streamlit Cloud demos — data is lost on restart).
# For the local event-driven stack, point it at your Docker Qdrant:
#   QDRANT_URL=http://localhost:6333
# For a persistent hosted store, use your Qdrant Cloud endpoint + key:
#   QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
#   QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_URL=
# QDRANT_API_KEY=
