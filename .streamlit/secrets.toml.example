# Streamlit secrets. Locally: copy to .streamlit/secrets.toml.
# On Streamlit Community Cloud: paste these into Settings -> Secrets (do NOT commit
# the real file). Streamlit also exposes these as environment variables.

# OPENAI_API_KEY is OPTIONAL. The deployed app asks each user for their own key in
# the sidebar (so usage is billed to them). Set this only if you want the sidebar
# field pre-filled for your own/local use.
# OPENAI_API_KEY = "sk-your-openai-key"

# Optional — persistent vector store instead of the default in-memory one:
# QDRANT_URL = "https://your-cluster.cloud.qdrant.io:6333"
# QDRANT_API_KEY = "your-qdrant-api-key"
